rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudScript(data, userId, scriptId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'content', 'format', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'content', 'format', 'createdAt', 'updatedAt'])
        && data.id is string
        && isValidId(data.id)
        && data.id == scriptId
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.title is string
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() <= 200000
        && data.format is string
        && data.format in ['markdown', 'plain']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /scripts/{scriptId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(scriptId)
          && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(scriptId)
          && isValidCloudScript(incoming(), userId, scriptId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(scriptId)
          && isValidCloudScript(incoming(), userId, scriptId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'format', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(scriptId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
